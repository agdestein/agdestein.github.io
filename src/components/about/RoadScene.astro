---
import Person from './Person.astro';
import { languages } from '../../../data/cv';
// Skills and languages: a journeyman with his tools reaches a crossroads where
// each arm of the sign greets him in a language picked up along the road.
// The far hills carry Paris, Saint Petersburg, and Amsterdam in miniature.
// One arm per language in data/cv.ts, alternating sides, top to bottom.
const post = 454;
const tilts = [-3, 2, 2, -2, 3, -1];
const signs = languages.map(({greeting}, i) => {
  const text = greeting.toUpperCase(), dir = i % 2 ? 1 : -1, y = 184 + i * 24, tilt = tilts[i % tilts.length];
  const w = text.length * 7.6 + 20, x0 = post - dir * 7, x1 = post + dir * w;
  return {text, y, tilt, d: `M${x0} ${y - 9}H${x1}L${x1 + dir * 9} ${y}L${x1} ${y + 9}H${x0}Z`, tx: post + dir * (w / 2 + 1)};
});
const s = 1.3;
---
<svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMax slice">
  <circle cx="118" cy="104" r="40" fill="var(--sun)" opacity=".16"/>
  <circle cx="118" cy="104" r="24" fill="var(--sun)"/>
  <g stroke="var(--snow)" stroke-width="11" stroke-linecap="round" opacity=".4">
    <path d="M196 78h70M214 66h30M330 116h56"/>
  </g>
  <!-- Far hills and the places behind him. -->
  <g fill="var(--ridge-back)">
    <path d="M0 266Q70 242 150 250T330 242Q420 234 490 244T600 238V330H0Z"/>
    <path d="M128 253Q134 236 137.5 218L139 196H141L142.5 218Q146 236 152 253H146Q140 243 134 253ZM133 236H147M136.5 222H143.5M140 196V188" stroke="var(--ridge-back)" stroke-width="1.4"/>
    <path d="M236 250V233H254V250ZM241 233V227H249V233ZM239 227C236 221 240 214 245 207C250 214 254 221 251 227ZM245 207V199M242.5 201.5H247.5" stroke="var(--ridge-back)" stroke-width="1.2"/>
    <path d="M504 246V230L509 223 514 230V246ZM515 246V228L520 220 525 228V246ZM526 246V231L530 225 534 231V246Z"/>
  </g>
  <path d="M0 298Q150 286 300 292T600 284V340H0Z" fill="var(--ridge-mid)"/>
  <path d="M0 336Q150 330 300 334T600 330V400H0Z" fill="var(--figure)"/>
  <!-- The road narrows over the rise toward the distance. -->
  <path d="M250 400Q300 352 350 316Q380 294 396 284H402Q398 300 404 322Q418 362 468 400Z" fill="var(--snow)" opacity=".3"/>
  <g fill="var(--figure)" stroke="var(--figure)" stroke-linecap="round" stroke-linejoin="round">
    <path d={`M${post} 344V170`} stroke-width="7"/>
    <circle cx={post} cy="167" r="5"/>
    {signs.map(sign => <path class="sign" d={sign.d} stroke-width="2" transform={`rotate(${sign.tilt} ${post} ${sign.y})`}/>)}
    <!-- The journeyman: brimmed hat, long coat, pack with a hammer, staff in hand. -->
    <Person at={[322, 340]} scale={s} hip={[0, -47]} shoulder={[3, -76]} head={[6, -87]}
      legs={[[[0, -47], [-6, -26], [-17, -9], [-11, -2]], [[0, -47], [11, -27], [16, -4], [24, -2]]]}
      arms={[[[1, -74], [-3, -60], [2, -52]], [[5, -74], [12, -60], [20, -55]]]}>
      <path d="M-7 -73Q-11 -52 -12 -30L9 -31Q10 -52 9 -70Z"/>
      <path d="M-8 -76Q-19 -76 -20 -64L-19 -50Q-18 -46 -8 -48Z"/>
      <ellipse cx="-13" cy="-79" rx="8" ry="4"/>
      <path d="M-15 -78-21 -95" fill="none" stroke-width="2.4"/>
      <path d="M-26 -93-16 -97" fill="none" stroke-width="4"/>
      <ellipse cx="6" cy="-92" rx="14" ry="2.6"/>
      <path d="M-1 -92Q-1 -102 6 -102Q13 -102 13 -92Z"/>
      <path d="M24 -2 17 -108" fill="none" stroke-width="3"/>
      <circle cx="17" cy="-109" r="2.8" stroke="none"/>
    </Person>
  </g>
  <g class="sign-text" fill="var(--snow)" text-anchor="middle" dominant-baseline="central">
    {signs.map(sign => <text x={sign.tx} y={sign.y} transform={`rotate(${sign.tilt} ${post} ${sign.y})`}>{sign.text}</text>)}
  </g>
</svg>
<style>
  .sign { fill: color-mix(in srgb, var(--figure) 82%, #000); stroke: color-mix(in srgb, var(--figure) 82%, #000); }
  .sign-text { font: 11px 'IBM Plex Mono', monospace; letter-spacing: .06em; }
</style>
