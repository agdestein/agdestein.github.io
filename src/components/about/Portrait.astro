---
import { Picture } from 'astro:assets';
import portrait from '../../assets/about/portrait.jpg';
/**
 * The full studio portrait in an arched frame, recolored for the active
 * atmosphere. The photograph is multiplied onto the theme's snow color, its
 * shadows are lifted to the nearest ridge color, and a faint wash of the theme's
 * glow falls from the upper corner, as the light does in each landscape.
 */
---
<figure class="portrait">
  <div class="portrait-frame">
    <Picture src={portrait} alt="Portrait of Syver Døving Agdestein" formats={['avif', 'webp']}
      width={720} widths={[360, 720, 1080]} sizes="(max-width: 600px) min(64vw, 260px), (max-width: 820px) 200px, (max-width: 1100px) 290px, 340px" loading="eager"/>
  </div>
</figure>
<style>
  .portrait { position: relative; width: 100%; max-width: 340px; margin: 0; }
  /* A second arch, offset behind the first, like a mount behind a print. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 16px -16px -16px 16px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 50% 50% 16px 16px / 33.4% 33.4% 16px 16px;
  }
  .portrait-frame {
    --duo-light: color-mix(in srgb, var(--snow) 50%, #fff);
    --duo-dark: color-mix(in srgb, var(--ridge-front) 70%, #000);
    --duo-glow: color-mix(in srgb, var(--glow) 38%, transparent);
    position: relative;
    isolation: isolate;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 50% 50% 16px 16px / 33.4% 33.4% 16px 16px;
    background: var(--duo-light);
    box-shadow: var(--shadow);
  }
  .portrait-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.05);
  }
  .portrait-frame::before, .portrait-frame::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
  .portrait-frame::before { z-index: 1; background: var(--duo-dark); mix-blend-mode: lighten; }
  .portrait-frame::after {
    z-index: 2;
    background: radial-gradient(circle at 88% 6%, var(--duo-glow), transparent 58%);
    mix-blend-mode: screen;
  }
  @media print { .portrait::before, .portrait-frame::before, .portrait-frame::after { display: none; } }
</style>
