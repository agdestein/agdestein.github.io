    <path d="M500 495Q721 235 929 350T1440 280V700H500Z" fill="var(--ridge-back)"/>
    <g stroke="var(--ridge-mid)" fill="var(--ridge-mid)">{Array.from({length:18},(_,i)=>{const x=620+i*52,y=170+(i*47%150);return <g><path d={`M${x} ${y}v390`} stroke-width={9+i%7}/><ellipse cx={x} cy={y+20} rx={50+i%3*9} ry="85"/><ellipse cx={x-18} cy={y+95} rx="52" ry="62"/></g>;})}</g>
