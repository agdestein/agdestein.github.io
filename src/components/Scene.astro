          <path d="M48 20C16 22 -14 42 -34 64C-37 66 -35 70 -31 70C-6 68 26 64 46 56C52 53 55 48 53 42Z"/>
          <path d="M140 88L198 58C202 56 206 59 205 63L202 76C201 80 198 83 194 84L138 104Z"/>
