---
// Aurora: stars keep to the sky above the fjord, the Plough anchors the north.
const stars = Array.from({length: 58}, (_, i) => ({ x: 410 + ((i * 137.51) % 940), y: 15 + ((i * 73.7) % 340), r: i % 7 === 0 ? 1.3 : .65 }));
// Dubhe, Merak, Phecda, Megrez, Alioth, Mizar, Alkaid, laid out from the J2000
// positions: bowl to the east, handle trailing west, Alkaid dropping at the tip.
// The third value is the dot radius; Megrez is the faint one at magnitude 3.3.
const plough = [[1382,212,2.6],[1390,255,2.3],[1327,279,2.3],[1307,249,1.8],[1261,247,2.6],[1225,242,2.4],[1178,272,2.6]];
const skerries = [{x:205,w:118,h:31},{x:432,w:72,h:18},{x:688,w:158,h:40},{x:900,w:62,h:16},{x:1094,w:130,h:34},{x:1332,w:96,h:23}];
// Glints lengthen, thicken, and space out as the water comes toward the viewer;
// the dash pattern keeps each row broken so the sheen never reads as a stripe.
const glints = Array.from({length: 22}, (_, i) => {
  const d = Math.pow(i / 21, 1.35);
  // Fourteen unequal segments span most of a row, so no rhythm repeats across its
  // width. Each row then drifts and dims on its own slow clock, some against the rest.
  const dashes = Array.from({length: 14}, (_, k) => 6 + ((i * 41 + k * 59 + k * k * 13) % 38));
  const o = +((.3 - d * .2) * (i % 4 === 1 ? 1.7 : .8)).toFixed(3);
  return { y: +(506 + d * 150).toFixed(1), x1: 660 + ((i * 419) % 520), x2: 1060 + ((i * 263) % 400) + d * 60,
    w: +(1.1 + d * 2).toFixed(2), dash: dashes.join(' '),
    cycle: dashes.reduce((a, b) => a + b, 0) * (i % 3 ? 1 : -1),
    drift: 58 + ((i * 97) % 86), fade: 16 + ((i * 53) % 21), delay: -((i * 37) % 45),
    o, o2: +(o * .34).toFixed(3) };
});
// One broad leaf, springing from the origin and curving to its tip. Slit monstera
// fronds turn to noise at this size, so the blade stays whole and reads at a glance.
const frond = 'M0 0C-23 24 -15 64 23 100C30 58 21 22 0 0Z';
// Leaves hang in fans of three from four points along the limb.
const fronds = [[1048,330],[1168,306],[1290,278],[1402,254]].flatMap(([x, y], g) =>
  [-36, -6, 24].map((r, k) => ({x, y, r: r + (g % 2 ? 9 : -7),
    s: +(.56 + ((g * 3 + k) % 4) * .12).toFixed(2), o: k === 1 ? 1 : .72})));
// The herd walks east along the shore; the middle one has dropped its head to graze.
const herd = [{x:942,y:611,s:.5},{x:1058,y:602,s:.57,graze:true},{x:1176,y:604,s:.52}];
---
<div class="scene" aria-hidden="true">
  <div class="sky"></div>
  <div class="aurora-static"></div>
  <svg class="landscape aurora-landscape" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="fjordWater" x1="0" y1="0" x2="0" y2="1"><stop stop-color="var(--ridge-mid)"/><stop offset=".55" stop-color="var(--ridge-front)"/><stop offset="1" stop-color="var(--sky-top)"/></linearGradient>
      <linearGradient id="fjordSheen" x1="0" y1="0" x2="0" y2="1"><stop stop-color="var(--glow)" stop-opacity=".2"/><stop offset="1" stop-color="var(--glow)" stop-opacity="0"/></linearGradient>
    </defs>
    <g fill="var(--snow)" opacity=".6">{stars.map(s => <circle cx={s.x} cy={s.y} r={s.r}/>)}</g>
    <!-- The Plough, the one figure in the sky that always points north. -->
    <g class="aurora-plough">
      <path d="M1382 212 1307 249 1327 279 1390 255Z M1307 249 1261 247 1225 242 1178 272" fill="none" stroke="var(--snow)" opacity=".13"/>
      <g fill="var(--snow)" opacity=".8">{plough.map(([x, y, r]) => <circle cx={x} cy={y} r={r}/>)}</g>
    </g>
    <!-- A far shore, then bare skerries standing on the waterline. -->
    <path d="M0 478Q180 460 330 476Q480 492 640 468Q820 448 990 470Q1130 488 1262 458Q1362 452 1440 464V502H0Z" fill="var(--ridge-back)" opacity=".5"/>
    <g fill="var(--ridge-mid)">{skerries.map(k => <path d={`M${k.x - k.w / 2} 501Q${k.x} ${501 - k.h * 2} ${k.x + k.w / 2} 501Z`}/>)}</g>
    <g fill="none" stroke="var(--snow)" opacity=".25">{skerries.map(k => <path d={`M${k.x - k.w * .18} ${501 - k.h * .88}Q${k.x + k.w * .06} ${501 - k.h * 1.5} ${k.x + k.w * .36} ${501 - k.h * .62}`}/>)}</g>
    <!-- The fjord holds the curtain's echo: a diffuse wash broken into drifting glints. -->
    <rect y="500" width="1440" height="200" fill="url(#fjordWater)"/>
    <g fill="var(--sky-top)" opacity=".35">{skerries.map(k => <path d={`M${k.x - k.w / 2} 501Q${k.x} ${501 + k.h * 1.4} ${k.x + k.w / 2} 501Z`}/>)}</g>
    <rect class="aurora-wash" y="500" width="1440" height="135" fill="url(#fjordSheen)"/>
    <g class="aurora-sheen" stroke="var(--glow)" stroke-linecap="round">{glints.map(g => <path d={`M${g.x1} ${g.y}H${g.x2}`} stroke-width={g.w} stroke-dasharray={g.dash}
      style={`--o:${g.o};--o2:${g.o2};--cycle:${g.cycle};--drift:${g.drift}s;--fade:${g.fade}s;--delay:${g.delay}s`}/>)}</g>
    <!-- Near shore, with a rim of snow where the water reaches it. -->
    <path d="M0 670Q240 642 490 660Q700 672 880 618Q1060 592 1230 608Q1340 616 1440 600V700H0Z" fill="var(--ridge-front)"/>
    <path d="M0 670Q240 642 490 660Q700 672 880 618Q1060 592 1230 608Q1340 616 1440 600" fill="none" stroke="var(--snow)" stroke-width="3" opacity=".28"/>
    <!-- A small herd works along the shore; hooves rest on the snow rim. -->
    <g class="aurora-herd" fill="var(--ridge-front)" stroke="var(--ridge-front)" stroke-linecap="round" stroke-linejoin="round">
      {herd.map(({x, y, s, graze}) => <g transform={`translate(${x} ${y}) scale(${s})`}>
        <g transform="translate(-70 -125)">
          <!-- Traced from a walking bull in profile. Far legs mid-stride, a shade behind. -->
          <g opacity=".7"><path d="M43 96 41 101 49 110 56 118 58 121 54 122 48 113 37 103 39 95Z M102 90 106 98 109 106 111 120 108 120 106 108 102 100 95 92Z"/></g>
          <!-- A long, deep barrel on a level back, with a short tail cocked at the rump. -->
          <path d="M80 59C74 60 68 61 62 62C56 62 49 62 45 63C40 63 39 63 37 65C35 66 34 68 34 71C34 73 35 77 36 80C36 82 37 86 39 88C41 90 43 91 46 92C49 93 53 93 58 93C63 93 70 94 76 93C81 93 86 91 90 91C95 90 98 91 101 89C103 87 104 82 104 78C105 74 104 69 103 65C101 62 99 59 95 58C91 57 85 58 80 59Z"/>
          <path d="M36 66C35 65 33 66 32 66C30 67 29 69 29 70C29 71 31 71 32 71C33 71 34 71 35 70C36 69 36 66 36 66Z"/>
          <!-- Near legs: the hind stands on an angled hock, the fore swings back. -->
          <path d="M46 90 38 99 34 104 33 116 33 124 34 125 28 125 29 120 28 105 27 101 31 95 35 87Z M94 90 87 104 79 118 79 125 75 125 75 118 82 104 82 91Z"/>
          <!-- Neck, head and antlers pivot inside the shoulder, so a grazer lowers its muzzle
               without lifting a hump. The neck is carried forward and low, the throat mane
               hangs shaggy, and the long muzzle ends blunt. -->
          <g transform={graze ? 'rotate(46 93 72)' : undefined}>
            <g fill="none" stroke-width="2.6" opacity=".6">
              <path d="M132 65C131 64 129 60 126 58C124 55 121 52 119 50C117 47 115 45 114 42C113 40 114 37 114 34C115 31 116 28 117 26C119 24 122 21 123 20"/>
              <path d="M115 44C113 44 107 45 105 44C103 44 102 42 102 42M114 38C113 37 109 34 108 34M133 64C134 64 139 63 142 63C145 63 148 63 150 64C152 65 153 68 153 68"/>
            </g>
            <path d="M92 58C94 56 96 57 100 57C104 58 111 60 115 61C119 62 124 63 126 63C128 63 126 61 127 60C128 60 128 59 129 59C129 59 130 61 131 62C133 62 134 63 136 64C138 65 139 67 142 68C144 70 147 72 149 74C151 75 153 75 153 76C154 77 155 79 154 80C154 81 152 82 151 82C149 83 147 84 145 83C142 83 140 81 137 81C134 81 130 83 127 84C124 85 122 88 120 89C118 90 118 92 117 92C116 93 115 91 114 91C113 91 112 92 110 92C108 92 104 90 101 90C98 90 95 91 93 90C91 89 88 87 87 83C86 79 86 72 86 67C87 63 90 60 92 58Z"/>
            <!-- Antlers stand taller than the body is deep: the beam sweeps back, then curls
                 forward in a C with tines off its rear edge, and the brow tine reaches out
                 over the face. The far antler sits behind, its brow tine dropping as a shovel. -->
            <g fill="none">
              <path d="M135 64C134 63 133 59 130 57C128 54 125 51 123 48C121 46 119 44 118 41C117 38 118 35 118 32C119 29 120 27 122 24C123 22 125 20 127 18C130 16 133 13 134 12" stroke-width="3.6"/>
              <path d="M119 27C119 27 117 25 116 25M118 37C117 36 112 32 111 31M119 44C117 44 111 44 108 44C106 43 105 41 104 40M126 20C125 20 121 19 120 19M136 61C137 61 140 59 142 58C144 57 148 57 150 56C152 55 154 55 155 54C156 53 156 51 156 51" stroke-width="2.6"/>
            </g>
          </g>
        </g>
      </g>)}
    </g>
  </svg>
  <svg class="landscape desert-landscape" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice">
    <defs><linearGradient id="duneLight" x1="0" y1="0" x2=".6" y2="1"><stop stop-color="var(--snow)"/><stop offset="1" stop-color="var(--ridge-back)"/></linearGradient></defs>
    <circle class="desert-sun" cx="1110" cy="290" r="71" fill="var(--snow)" opacity=".9"/>
    <path d="M0 520Q235 461 436 510T832 460Q1060 322 1440 407V700H0Z" fill="var(--ridge-back)" opacity=".65"/>
    <path d="M0 594Q250 465 548 563Q920 587 1123 375Q1057 513 1440 566V700H0Z" fill="url(#duneLight)"/>
    <path d="M1123 375Q1031 537 847 602Q1154 584 1440 658V566Q1057 513 1123 375Z" fill="var(--ridge-mid)"/>
    <path d="M0 669Q400 619 646 637Q1055 509 1440 587V700H0Z" fill="var(--ridge-front)"/>
    <path d="M646 637Q1055 509 1440 587Q1159 554 989 640T646 637Z" fill="var(--ridge-mid)"/>
    <!-- A small dromedary caravan follows the near dune crest. -->
    <g class="desert-caravan" fill="var(--ridge-front)" stroke="var(--ridge-front)" stroke-linecap="round" stroke-linejoin="round">
      {[{x:1005,y:508,s:.57},{x:1080,y:505,s:.65},{x:1164,y:507,s:.7}].map(({x,y,s})=><g transform={`translate(${x} ${y}) scale(${s})`}>
        <g transform="translate(0 4) scale(.78)" stroke="none">
          <!-- Far legs are offset in stride; the near legs carry the weight. -->
          <path d="M28 35C28 47 26 54 22 61L13 72Q11 76 11 83L9 94Q5 94 5 98L8 102Q12 102 14 97L16 82Q16 77 20 74L32 62Q39 51 38 39Z"/>
          <path d="M78 40Q79 51 74 64L68 77 59 98Q55 99 55 103Q60 105 67 103L67 100 74 80 82 67Q88 51 87 40Z"/>
          <!-- Rounded rump, broad hump, deep belly, and a low sweeping neck. -->
          <path d="M22 32C22 23 28 16 39 14C44 12 48 3 56 1C65-2 72 5 78 10C84 13 87 14 90 21C94 29 100 31 105 27C110 23 111 13 115 7Q117 3 121 4L126 6Q133 4 138 8L142 11Q144 14 141 16L134 17Q132 20 125 20C121 29 117 37 111 41Q101 48 92 43Q89 45 85 45C76 51 65 53 54 51Q42 49 35 44Q28 45 24 40Z"/>
          <!-- Upper thighs taper into slender lower legs and padded feet. -->
          <path d="M26 31C24 40 26 48 28 55Q30 59 28 64L27 76Q27 79 29 83L34 99Q32 101 33 104Q38 106 45 104Q46 102 41 100L35 79Q34 76 35 72L38 57C41 50 41 41 39 35Z"/>
          <path d="M80 34Q80 46 83 56L85 72Q84 76 87 80L98 99Q95 101 96 104Q103 105 110 103Q111 101 104 99L92 76Q94 73 91 69L90 51Q91 43 89 38Z"/>
          <!-- Small rounded ear, muzzle, and hanging tail tuft. -->
          <path d="M117 8Q112 7 113 2Q117 0 121 6Z"/>
          <path d="M25 26Q18 32 20 46Q21 53 16 61L15 67Q23 63 24 54Q25 49 23 43Q21 35 27 31Z"/>
        </g>
      </g>)}
    </g>
    <g fill="none" stroke="var(--snow)" opacity=".2">{Array.from({length: 12},(_,i)=><path d={`M${860+i*10} ${633+i*6}Q1140 ${562+i*10} 1440 ${627+i*6}`}/>)}</g>
  </svg>
  <svg class="landscape coffee-landscape" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice">
    <defs>
